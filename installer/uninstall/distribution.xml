<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Uninstall Siren</title>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.txt" mime-type="text/plain"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default">
        <pkg-ref id="ch.danikoenig.siren.uninstall"/>
    </choice>
    <pkg-ref id="ch.danikoenig.siren.uninstall" version="@VERSION@" onConclusion="none">SirenUninstall.pkg</pkg-ref>
</installer-gui-script>
